#!/bin/sh
# After a pull that changed ai/, re-apply the AI setup with ai/apply. Never fails the pull: errors only warn.
if [ "$1" = rebase ]; then
  # From post-rewrite. Resets during a conflicted rebase can move ORIG_HEAD, but the branch reflog's
  # previous entry is still the tip before the rebase started.
  before=$(git rev-parse -q --verify '@{1}') || before=ORIG_HEAD
  git diff --quiet "$before" HEAD -- ai/ && exit 0
elif [ "$1" = 1 ]; then
  # A squash merge leaves HEAD unmoved and the merged files only in the working tree.
  before=HEAD
  git diff --quiet HEAD -- ai/ && exit 0
else
  before=ORIG_HEAD
  git diff --quiet ORIG_HEAD HEAD -- ai/ && exit 0
fi
ai/apply --since "$before" ||
  echo "warning: ai/apply failed; the pull is kept. Fix the error above, then run: ai/apply" >&2
exit 0
